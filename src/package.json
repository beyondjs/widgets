{
	"name": "@beyond-js/widgets",
	"version": "1.1.4",
	"description": "Create web projects as standalone microfrontends with beyondJS",
	"repository": "https://github.com/beyondjs/widgets",
	"license": "MIT",
	"modules": {
		"path": "./modules"
	},
	"dependencies": {
		"@beyond-js/kernel": "~0.1.13"
	},
	"deployment": {
		"distributions": [
			{
				"name": "web",
				"platform": "web",
				"ports": {
					"bundles": 9121
				},
				"ts": {
					"compiler": "tsc"
				}
			},
			{
				"name": "ssr",
				"platform": "ssr",
				"ports": {
					"bundles": 9122
				},
				"ts": {
					"compiler": "tsc"
				}
			}
		]
	},
	"beyond": {
		"publication": {
			"protocol": "beyond-publication/1",
			"form": "source"
		},
		"modules": "./modules",
		"bundler": "ts"
	},
	"bundlers": {
		"ts": {
			"specifier": "@beyond-js/packages/bundlers/ts",
			"runtime": "@beyond-js/local-2026/bundle"
		}
	}
}
